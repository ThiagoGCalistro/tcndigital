# =========================================================================
# Variáveis do blog WordPress da TCN Digital.
# Copie para `.env` (NÃO versionar o .env) e ajuste conforme o ambiente.
#
# NUNCA coloque as credenciais reais de produção aqui no repositório.
# Em produção (EasyPanel), defina estas variáveis como SECRETS no painel.
# =========================================================================

# ---- Dev local (docker-compose) ----
DB_NAME=wordpress
DB_USER=wp
DB_PASSWORD=wplocal
DB_ROOT_PASSWORD=rootlocal
DB_PREFIX=wp_

# URL do site principal (usada nos links do tema)
TCN_MAIN_SITE=https://tcndigital.com.br

# ---- Produção (EasyPanel) — definir como secrets, NÃO aqui ----
# WORDPRESS_DB_HOST=tcndigital_mariadb:3306      # host INTERNO do MariaDB
# WORDPRESS_DB_NAME=tcndigital_blog              # banco dedicado ao blog
# WORDPRESS_DB_USER=tcnuser
# WORDPRESS_DB_PASSWORD=********                 # secret
# WORDPRESS_TABLE_PREFIX=wp_
# WORDPRESS_CONFIG_EXTRA=                        # ver README (WP_HOME/WP_SITEURL + HTTPS proxy)
